# cp .env.example .env.local して埋めてください
# ── アプリ基本 ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=あなたのSaaS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_OG_IMAGE_URL=

# ── Firebase（クライアント）────────────────────────────────
# Firebase コンソール → プロジェクトの設定 → マイアプリ（ウェブ）からコピー
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin（サーバー）──────────────────────────────
# サービスアカウント JSON から。PRIVATE_KEY は改行を \n のままダブルクォートで囲む
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# 運営者として扱うメールアドレス（カンマ区切り）
ADMIN_EMAILS=

# ── 法令ページ（特商法 / プラポリ / 利用規約）───────────────
# ここを埋めるだけで /legal/* の3ページが自社の内容になる
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_OPERATOR=
INVOICE_ISSUER_ADDRESS=
INVOICE_ISSUER_TEL=
INVOICE_ISSUER_EMAIL=
# 適格請求書発行事業者の登録番号（T + 13桁）。未取得なら空でよい
INVOICE_ISSUER_REGISTRATION_NUMBER=

# ── 任意 ───────────────────────────────────────────────────
# Sentry（未設定ならエラーは console にだけ出る）
SENTRY_DSN=
# Upstash Redis（未設定ならレート制限はプロセス内メモリにフォールバック）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Resend（設定するとプライバシーポリシーの第三者提供欄に反映される）
RESEND_API_KEY=
# LP と法令ページだけの静的サイトとしてビルドするとき 1
MARKETING_ONLY=
